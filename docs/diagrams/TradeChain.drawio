  <diagram id="workflow" name="Workflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="wf_title" value="TradeChain - End-to-End Trade Workflow (6 contracts)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="S1" value="1. Importer - createOrder(seller, Incoterm, USD amount, deadline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="60" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="2. Exporter - register Commercial Invoice + Packing List, createShipment(orderId)&#10;(ShipmentTracker mints the e-B/L title token, escrowed by the core)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="135" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="3. Bank / Importer - issue and fund the Letter of Credit&#10;TradeUSD escrowed in LetterOfCredit.sol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="4. Logistics - confirmPickup() - risk transfers; EXW pays out here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="285" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="5. Logistics - confirmVesselLoading() + anchor Bill of Lading / AWB&#10;title tokenURI set; FOB / CIF pay out here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="360" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S6" value="6. Verifier / Authorities - anchor Inspection, Insurance and Customs certificates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="435" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S7" value="7. ComplianceEngine - validate the Incoterm-required document set (+ duty for DDP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="510" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S8" value="8. ShipmentTracker - transfer the document of title (ERC-721) to the Importer&#10;DDP pays out here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="585" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S9" value="9. LetterOfCredit - release escrowed TradeUSD to the Exporter&#10;(atomic payout, CEI + nonReentrant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="660" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="T1" value="Settled - Exporter paid, Importer holds the document of title" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="745" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="E3" value="Exception - deadline passed with no shipment:&#10;reclaimExpiredLC() refunds the Importer -&gt; Reclaimed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="830" width="620" height="55" as="geometry" />
        </mxCell>

        <mxCell id="OFL" value="Off-chain (consortium IPFS, private swarm): each role runs its own kubo node. The issuing role adds the document to its node, the CID is anchored on-chain (DocumentRegistry), then the CID is manually pinned to the other nodes. One CID per (shipment, docType); no contract change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="585" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="TITLE" value="Title token lifecycle&#10;minted in ShipmentTracker at createShipment (held by the core)&#10;tokenURI = ipfs://&lt;B/L CID&gt; set at confirmVesselLoading&#10;transferTitle to the Importer at settlement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="285" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="ws1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="S1" target="S2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
