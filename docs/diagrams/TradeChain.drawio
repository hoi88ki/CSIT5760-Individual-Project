        <mxCell id="O2" value="Off-chain: Consortium IPFS - one kubo node per role (optional private swarm)&#10;Each role uploads to its own node; a document is addressed by CID and replicated/pinned&#10;across the consortium, so any replica can serve the same CID (integrity is content-addressed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="515" height="200" as="geometry" />
