        <mxCell id="O1" value="Web3 DApp - React (Vite) + Ethers.js v6 + MetaMask&#10;Role dashboard: upload to the role's IPFS node, sign transactions,&#10;trigger TradeChainCore workflows on Ethereum Sepolia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
