        </mxCell>
        <mxCell id="ws6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="S6" target="S7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ws7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="S7" target="S8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ws8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="S8" target="S9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ws9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="S9" target="T1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wd1" value="raise dispute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="S6" target="D1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wd2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="D1" target="E1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wd3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="E1" target="E2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wd4" value="release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="E2" target="S9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we3" value="no shipment before deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="S3" target="E3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OFL" value="Off-chain (consortium IPFS, private swarm): each role (exporter, importer, bank, logistics, verifier) runs its own node. The issuing role adds the document to its node, the CID is anchored on-chain (DocumentRegistry), and the CID is manually pinned to the other nodes so any party can retrieve it. One CID per (shipment, docType); no contract change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="650" width="350" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
