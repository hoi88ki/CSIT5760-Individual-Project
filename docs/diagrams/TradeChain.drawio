        <mxCell id="we3" value="no shipment before deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="S3" target="E3">
          <mxGeometry relative="1" as="geometry" />
